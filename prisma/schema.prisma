// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============= SCHOOL & TENANT =============

model School {
  id                String   @id @default(cuid())
  name              String
  schoolCode        String?
  address           String
  state             String
  lga               String
  schoolType        String   @default("[\"primary\"]") // JSON string array: ["creche", "kg", "primary", "secondary"]
  logo              String?
  admissionPattern  String   @default("{year}/{seq}")
  admissionCounter  Int      @default(1)
  arms              String   @default("[]")
  principalId       String?  @unique
  paymentMode       String   @default("manual") // manual | paystack | both
  manualBankDetails Json?    // { bankName, accountName, accountNumber }
  paystackSurchargePercent Float @default(0)
  paystackSurchargeFlat     Float @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users              User[]
  classes            Class[]
  subjects           Subject[]
  students           Student[]
  academicTerms      AcademicTerm[]
  holidays           Holiday[]
  examSessions       ExamSession[]
  staff              Staff[]
  timetableEntries   TimetableEntry[]
  timetables         Timetable[]
  timetableConfigs   TimetableConfig[]
  announcements      Announcement[]
  calendarEvents     CalendarEvent[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  payments           Payment[]
  reports            Report[]
  reportSettings     SchoolReportSettings?
  scoreComponents    ScoreComponent[]
  scoreSchemes       ScoreScheme[]
  gradeScales        GradeScale[]
  notifications      Notification[]
  examBroadcastRequests ExamBroadcastRequest[]
  caBroadcasts          CaBroadcast[]
  examSheetBroadcasts   ExamSheetBroadcast[]
  examResultDeliveries  ExamResultDelivery[]
  principal          User?     @relation("SchoolPrincipal", fields: [principalId], references: [id], onDelete: SetNull)

  @@index([principalId])
}

// ============= USERS & AUTHENTICATION =============

model User {
  id           String   @id @default(cuid())
  schoolId     String?
  email        String?  @unique
  name         String
  phone        String?  @unique
  role         String   @default("teacher")
  image          String?
  dateOfBirth    DateTime?
  employmentDate DateTime?
  address        String?
  gender         String? // M, F
  formClassId    String?
  passwordHash   String?
  emailVerified  Boolean  @default(false)
  active         Boolean  @default(true)
  approvalStatus String   @default("APPROVED") // APPROVED, PENDING, REJECTED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school            School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolAsPrincipal School?              @relation("SchoolPrincipal")
  formClass         Class?               @relation(fields: [formClassId], references: [id], onDelete: SetNull)
  assignments       TeacherAssignment[]
  inviteTokens      InviteToken[]
  resetTokens       PasswordResetToken[]
  sessions          Session[]
  timetableEntries  TimetableEntry[]
  notifications     Notification[]
  examBroadcastRequests ExamBroadcastRequest[]
  examBroadcastReviews ExamBroadcastRequest[] @relation("ExamBroadcastReviewedBy")
  examSheetBroadcasts ExamSheetBroadcast[] @relation("ExamSheetBroadcastTeacher")
  examSheetReviews ExamSheetBroadcast[] @relation("ExamSheetBroadcastReviewedBy")

  @@index([schoolId])
  @@index([role])
  @@index([email])
  @@index([phone])
  @@index([formClassId])
}

// ============= TEACHER ASSIGNMENTS =============

model TeacherAssignment {
  id        String   @id @default(cuid())
  teacherId String
  schoolId  String
  type      String // "form" or "subject"
  subjectId String? // null for form teacher, subject id for subject teacher
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncStatus String    @default("pending")
  syncedAt   DateTime?
  version    Int       @default(1)

  teacher User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  classes TeacherAssignmentClass[]

  @@unique([teacherId, type, subjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([syncStatus])
}

model TeacherAssignmentClass {
  id           String   @id @default(cuid())
  assignmentId String
  classId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment TeacherAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  class      Class             @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, classId])
  @@index([classId])
}

// ============= INVITE & PASSWORD RESET TOKENS =============

model InviteToken {
  id           String    @id @default(cuid())
  schoolId     String
  invitedBy    String
  token        String    @unique
  invitedName  String?
  invitedPhone String?
  invitedEmail String?
  role         String    @default("teacher")
  expiresAt    DateTime
  usedAt       DateTime?
  usedBy       String?
  emailFailed  Boolean   @default(false)
  emailError   String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([invitedBy])
  @@index([schoolId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model OTP {
  id        String   @id @default(cuid())
  phone     String?
  email     String?
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
  @@index([code])
}

// ============= SESSIONS & DEVICES =============

model Session {
  id             String   @id @default(cuid())
  userId         String
  deviceId       String
  deviceType     String // "phone", "tablet", "web"
  deviceName     String?
  isPrimary      Boolean  @default(false)
  refreshToken   String   @unique
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([refreshToken])
}

// ============= SCHOOL STRUCTURE =============

model Class {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // JSS 1A, SS 2B, etc
  level     String // JSS 1, JSS 2, SS 1, etc
  arm       String // A, B, C, etc
  schoolType String // creche | kg | primary | secondary (or a custom school type)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sync metadata
  syncStatus String    @default("pending") // "pending" | "synced" | "failed"
  syncedAt   DateTime?
  version    Int       @default(1)

  // Relations
  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students         Student[]
  assignmentLinks  TeacherAssignmentClass[]
  formTeachers     User[]
  timetableEntries TimetableEntry[]
  timetables       Timetable[]
  examSessions     ExamSession[]
  classSubjects    ClassSubject[]
  caBroadcasts     CaBroadcast[]
  examSheetBroadcasts ExamSheetBroadcast[]
  examResultDeliveries ExamResultDelivery[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([syncStatus])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // Mathematics, English, Biology, etc
  code      String? // MATH, ENG, BIO, etc
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sync metadata
  syncStatus String    @default("pending") // "pending" | "synced" | "failed"
  syncedAt   DateTime?
  version    Int       @default(1)

  // Relations
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]
  examSessions ExamSession[]
  timetableEntries TimetableEntry[]
  classSubjects ClassSubject[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([syncStatus])
}

// ============= CLASS <-> SUBJECT ASSIGNMENTS =============

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
}

// ============= STUDENTS & RECORDS =============

model Student {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String
  name        String
  admissionNo String // unique per school
  dateOfBirth DateTime?
  gender      String? // M, F
  address     String?
  imageUrl    String?
  parentName  String?
  parentPhone String?
  parentEmail String?
  status      String    @default("ACTIVE") // ACTIVE, TRANSFERRED, WITHDRAWN, GRADUATED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Sync metadata
  syncStatus String    @default("pending") // "pending" | "synced" | "failed"
  syncedAt   DateTime?
  version    Int       @default(1)

  // Relations
  school            School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class             Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendanceRecords Attendance[]
  timeline          StudentTimeline[]
  examScores        ExamScore[]
  invoices          Invoice[]
  payments          Payment[]
  examResultDeliveries ExamResultDelivery[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([classId])
  @@index([syncStatus])
  @@index([status])
}

// ============= ATTENDANCE =============

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  date      DateTime
  status    String // "present", "absent", "late"
  remarks   String?
  deviceId  String? // which device created this
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sync metadata
  syncStatus String    @default("pending") // "pending" | "synced" | "failed"
  syncedAt   DateTime?
  version    Int       @default(1)

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, date])
  @@index([studentId])
  @@index([classId])
  @@index([date])
  @@index([syncStatus])
}

// ============= ATTENDANCE DAY NOTES =============

model AttendanceNote {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  date      DateTime
  note      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, date])
  @@index([schoolId])
  @@index([classId])
  @@index([date])
}

// ============= ACADEMIC TERMS =============

model AcademicTerm {
  id        String   @id @default(cuid())
  schoolId  String
  term      String   // "1", "2", "3"
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, term])
  @@index([schoolId])
}

// ============= HOLIDAYS =============

model Holiday {
  id        String   @id @default(cuid())
  schoolId  String
  date      DateTime // date only, no time component
  reason    String   // "Democracy Day", "Mid-term break"
  createdBy String   // principal userId
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
  @@index([schoolId])
  @@index([schoolId, date])
}

// ============= STUDENT TIMELINE =============

model StudentTimeline {
  id          String   @id @default(cuid())
  studentId   String
  type        String   // ADMISSION, PROMOTION, STATUS_CHANGE, CLASS_TRANSFER
  description String
  date        DateTime
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ============= EXAMINATIONS =============

model ExamSession {
  id          String   @id @default(cuid())
  schoolId    String
  subjectId   String
  classId     String?
  componentId String?
  name        String
  type        String   // QUIZ, TEST, ASSIGNMENT, PROJECT, EXAM
  term        String
  session     String
  maxScore    Int      @default(100)
  date        DateTime
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, COMPLETED
  visibleToParents Boolean @default(false) // teacher broadcast flag (kept editable)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject   Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class     Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  component ScoreComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  scores    ExamScore[]
  broadcastRequest ExamBroadcastRequest?

  @@index([schoolId])
  @@index([subjectId])
  @@index([classId])
  @@index([componentId])
  @@index([term, session])
  @@unique([schoolId, subjectId, classId, componentId, term, session])
}

// Teacher → principal broadcast approval for terminal exams / report cards.
model ExamBroadcastRequest {
  id          String   @id @default(cuid())
  schoolId    String
  examId      String   @unique
  teacherId   String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviewedAt  DateTime?
  reviewedById String?

  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam        ExamSession @relation(fields: [examId], references: [id], onDelete: Cascade)
  teacher     User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reviewedBy  User?  @relation("ExamBroadcastReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([teacherId])
}

// Class-teacher broadcast center: a whole-class CA broadcast (Test 1, Test 2,
// Practical, ...). No principal approval — CA goes straight to parents. The
// record tracks which components were included and when it last happened.
model CaBroadcast {
  id           String   @id @default(cuid())
  schoolId     String
  classId      String
  term         String
  session      String
  componentIds Json     // string[] of ScoreComponent ids included in the broadcast
  broadcastAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([schoolId, classId, term, session])
  @@index([schoolId, term, session])
}

// Class-wide terminal-exam sheet approval. The form teacher submits the whole
// class's exam sheet; the principal reviews it as an "Exam sheet approval".
// On approval every EXAM-type session for the class+term becomes visible and
// only the students not already delivered get notified.
model ExamSheetBroadcast {
  id           String    @id @default(cuid())
  schoolId     String
  classId      String
  term         String
  session      String
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  note         String?
  teacherId    String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher    User?  @relation("ExamSheetBroadcastTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  reviewedBy User?  @relation("ExamSheetBroadcastReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, classId, term, session])
  @@index([schoolId, status])
  @@index([classId, term, session])
}

// Which students' terminal-exam results have already been sent to their parents
// for a class + term. Lets the form teacher re-broadcast only the newly
// completed students, or individually resend one child — without needing a new
// principal approval once the sheet is approved.
model ExamResultDelivery {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  term        String
  session     String
  studentId   String
  deliveredAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, classId, term, session, studentId])
  @@index([schoolId])
  @@index([studentId])
}

model ScoreComponent {
  id        String   @id @default(cuid())
  schoolId  String
  schemeId  String
  term      String
  session   String
  name      String // "Test 1", "Assignment", "Exam", etc
  type      String   @default("OTHER") // TEST, ASSIGNMENT, PROJECT, PRACTICAL, EXAM, PHYSICAL, OTHER
  maxScore  Int      @default(100)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scheme       ScoreScheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  examSessions ExamSession[]

  @@unique([schemeId, name])
  @@index([schoolId, term, session])
  @@index([schemeId])
}

// A score configuration: a named set of ScoreComponents scoped to an array of
// school types (e.g. ["primary", "secondary"]) for a term. A class's scores use
// the configuration whose schoolTypes include the class's schoolType.
model ScoreScheme {
  id          String   @id @default(cuid())
  schoolId    String
  term        String
  session     String
  schoolTypes String // JSON string array, normalized (sorted + deduped)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scoreComponents ScoreComponent[]

  @@unique([schoolId, term, session, schoolTypes])
  @@index([schoolId, term, session])
  @@index([schoolId])
}

model GradeScale {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  bands     Json // [{ minScore, grade, remark }] sorted by minScore desc
  levels    String[] @default([]) // class levels this scale applies to, e.g. ["JSS 1", "JSS 2"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model ExamScore {
  id        String   @id @default(cuid())
  examId    String
  studentId String
  score     Float
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    ExamSession @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

// ============= NON-TEACHING STAFF =============

model Staff {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  email       String?
  phone       String?
  gender      String?
  role        String
  department  String?
  designation String?
  status      String   @default("INVITED") // ACTIVE, INVITED, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

// ============= TIMETABLE =============

model Timetable {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  title     String
  breaks    Json? // [{ day, label, start, end }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([schoolId, classId])
  @@index([schoolId])
}

// One shared, rigid school-day + subject configuration per school-type batch
// (e.g. every primary class uses the "primary" config). Class.schoolType maps to
// config.configType, so Primary 1–6 automatically share one configuration.
model TimetableConfig {
  id            String   @id @default(cuid())
  schoolId      String
  configType    String // primary | kg | creche | secondary | custom
  name          String // e.g. "Primary School Configuration"
  schedule      Json // DayPeriodBlock[] (day blocks + breaks)
  subjectIds    Json // string[]
  targets       Json // Record<subjectId, weeklyPeriods>
  doublePeriods Json // { subjectId, days }[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, configType])
  @@index([schoolId])
}

model TimetableEntry {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  subjectId   String
  teacherId   String
  day         String   // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY
  period      Int
  startTime   String
  endTime     String
  room        String?
  timetableId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timetable Timetable? @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([schoolId, classId, day, period])
  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
  @@index([timetableId])
}

// ============= ANNOUNCEMENTS =============

model Announcement {
  id        String   @id @default(cuid())
  schoolId  String
  title     String
  message   String
  audience  String   // ALL_STAFF, TEACHING_ONLY, NON_TEACHING_ONLY, ALL_PARENTS, ALL_USERS
  priority  String   @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([audience])
}

// ============= CALENDAR EVENTS =============

model CalendarEvent {
  id          String   @id @default(cuid())
  schoolId    String
  title       String
  description String?
  date        DateTime
  type        String   // HOLIDAY, EVENT, EXAM, MEETING, SPORTS
  audience    String   @default("ALL") // ALL, TEACHERS, PARENTS, STAFF
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([date])
}

// ============= NOTIFICATIONS =============

model Notification {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  title     String
  message   String
  type      String   // ANNOUNCEMENT, CALENDAR_EVENT, HOLIDAY, ATTENDANCE, INVITE, EXAM
  route     String?  // deep link destination, e.g. /teach/announcements
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId, read])
  @@index([userId, createdAt])
}

// ============= FINANCE =============

model FeeStructure {
  id           String   @id @default(cuid())
  schoolId     String
  classIds     Json     // array of class ids this structure applies to
  term         String
  session      String
  name         String
  amount       Float
  items        Json?
  isCompulsory Boolean  @default(true)
  createdAt    DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([schoolId])
}

model Invoice {
  id              String    @id @default(cuid())
  schoolId        String
  studentId       String
  feeStructureId  String
  amount          Float
  items           Json?
  issuedByName    String?
  status          String    @default("UNPAID") // UNPAID, PARTIAL, PAID
  dueDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure  @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([schoolId])
  @@index([studentId])
  @@index([status])
}

model Payment {
  id             String    @id @default(cuid())
  schoolId       String
  invoiceId      String
  studentId      String
  amount         Float
  method         String    // CASH, TRANSFER, POS, ONLINE
  reference      String?
  recordedBy     String
  status         String    @default("CONFIRMED") // PENDING, CONFIRMED, REJECTED
  submittedAt    DateTime?
  confirmedAt    DateTime?
  rejectedReason String?
  receiptNo      String?
  createdAt      DateTime  @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, reference])
  @@index([schoolId])
  @@index([invoiceId])
  @@index([studentId])
  @@index([status])
}

// ============= REPORTS =============

model Report {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  term        String
  session     String
  type        String   // REPORT_CARD, CLASS_SUMMARY, ATTENDANCE, FULL
  status      String   @default("PENDING") // PENDING, GENERATED, FAILED
  downloadUrl String?
  generatedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model SchoolReportSettings {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  template  String   @default("classic") // classic, modern, compact
  theme     String   @default("slate") // slate, emerald, indigo, amber
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}
