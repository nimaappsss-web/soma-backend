// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============= SCHOOL & TENANT =============

model School {
  id          String   @id @default(cuid())
  name        String
  address     String
  state       String
  lga         String
  schoolType  String   @default("secondary")
  logo        String?
  schoolCode  String?
  principalId String?  @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  classes   Class[]
  subjects  Subject[]
  students  Student[]
  principal User?     @relation("SchoolPrincipal", fields: [principalId], references: [id], onDelete: SetNull)

  @@index([principalId])
}

// ============= USERS & AUTHENTICATION =============

model User {
  id           String   @id @default(cuid())
  schoolId     String?
  email        String?  @unique
  name         String
  phone        String?  @unique
  role         String   @default("teacher")
  image          String?
  passwordHash   String?
  emailVerified  Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school            School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolAsPrincipal School?              @relation("SchoolPrincipal")
  assignments       TeacherAssignment[]
  inviteTokens      InviteToken[]
  resetTokens       PasswordResetToken[]
  sessions          Session[]

  @@index([schoolId])
  @@index([role])
  @@index([email])
  @@index([phone])
}

// ============= TEACHER ASSIGNMENTS =============

model TeacherAssignment {
  id        String   @id @default(cuid())
  teacherId String
  schoolId  String
  type      String // "form" or "subject"
  subjectId String? // null for form teacher, subject id for subject teacher
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncStatus String    @default("pending")
  syncedAt   DateTime?
  version    Int       @default(1)

  teacher User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  classes TeacherAssignmentClass[]

  @@unique([teacherId, type, subjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([syncStatus])
}

model TeacherAssignmentClass {
  id           String   @id @default(cuid())
  assignmentId String
  classId      String
  createdAt    DateTime @default(now())

  assignment TeacherAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  class      Class             @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, classId])
  @@index([classId])
}

// ============= INVITE & PASSWORD RESET TOKENS =============

model InviteToken {
  id           String    @id @default(cuid())
  schoolId     String
  invitedBy    String
  token        String    @unique
  invitedName  String?
  invitedPhone String?
  invitedEmail String?
  role         String    @default("teacher")
  expiresAt    DateTime
  usedAt       DateTime?
  usedBy       String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([invitedBy])
  @@index([schoolId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model OTP {
  id        String   @id @default(cuid())
  phone     String?
  email     String?
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
  @@index([code])
}

// ============= SESSIONS & DEVICES =============

model Session {
  id             String   @id @default(cuid())
  userId         String
  deviceId       String
  deviceType     String // "phone", "tablet", "web"
  deviceName     String?
  isPrimary      Boolean  @default(false)
  refreshToken   String   @unique
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([refreshToken])
}

// ============= SCHOOL STRUCTURE =============

model Class {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // JSS 1A, SS 2B, etc
  level     String // JSS 1, JSS 2, SS 1, etc
  arm       String // A, B, C, etc
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sync metadata
  syncStatus String    @default("pending") // "pending" | "synced" | "failed"
  syncedAt   DateTime?
  version    Int       @default(1)

  // Relations
  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students         Student[]
  assignmentLinks  TeacherAssignmentClass[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([syncStatus])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // Mathematics, English, Biology, etc
  code      String? // MATH, ENG, BIO, etc
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sync metadata
  syncStatus String    @default("pending") // "pending" | "synced" | "failed"
  syncedAt   DateTime?
  version    Int       @default(1)

  // Relations
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([syncStatus])
}

// ============= STUDENTS & RECORDS =============

model Student {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String
  name        String
  admissionNo String // unique per school
  dateOfBirth DateTime?
  gender      String? // M, F
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Sync metadata
  syncStatus String    @default("pending") // "pending" | "synced" | "failed"
  syncedAt   DateTime?
  version    Int       @default(1)

  // Relations
  school            School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class             Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendanceRecords Attendance[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([classId])
  @@index([syncStatus])
}

// ============= ATTENDANCE =============

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  date      DateTime
  status    String // "present", "absent", "late"
  remarks   String?
  deviceId  String? // which device created this
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sync metadata
  syncStatus String    @default("pending") // "pending" | "synced" | "failed"
  syncedAt   DateTime?
  version    Int       @default(1)

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, date])
  @@index([studentId])
  @@index([classId])
  @@index([date])
  @@index([syncStatus])
}
